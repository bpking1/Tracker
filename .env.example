# 推荐：TMDB API 设置页面中的 API Read Access Token
TMDB_API_TOKEN=your_tmdb_read_access_token

# 或使用传统 API Key（二选一）
# TMDB_API_KEY=your_tmdb_api_key

# 可选：按数组顺序查询多个 Emby 服务。地址可以带或不带末尾的 /emby
# EMBY_SERVERS=[{"name":"家中","url":"http://127.0.0.1:8096","apiKey":"your_emby_api_key"},{"name":"备用","url":"https://emby.example.com","apiKey":"your_other_emby_api_key"}]

# 可选：按数组顺序查询多个 Plex 服务
# PLEX_SERVERS=[{"name":"家中 Plex","url":"http://127.0.0.1:32400","token":"your_plex_token"},{"name":"备用 Plex","url":"https://plex.example.com","token":"your_other_plex_token"}]

# 可选：播放来源查询顺序，必须同时且各包含一次 emby、plex
# PLAYBACK_PROVIDER_ORDER=plex,emby
